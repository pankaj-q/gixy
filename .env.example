PORT=3007
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY=24h
MONGODB_URI=mongodb+srv://codepankaj84:pankajji12@cluster1.8rhuxxs.mongodb.net/gixy
LOG_LEVEL=debug

# LLM Provider Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4-turbo-preview
OPENAI_ORGANIZATION=your_org_id
OPENAI_TIMEOUT=60000
OPENAI_MAX_RETRIES=3

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_DEFAULT_MODEL=claude-3-opus-20240229
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_TIMEOUT=60000
ANTHROPIC_MAX_RETRIES=3

# LLM Engine Configuration
LLM_DEFAULT_PROVIDER=openai
LLM_FALLBACK_PROVIDER=anthropic
LLM_REQUEST_TIMEOUT=60000
LLM_MAX_CONCURRENT=5
LLM_ENABLE_CACHE=false
LLM_CACHE_TTL=3600000
LLM_LOG_LEVEL=info

# Risk Analysis Engine
RISK_ANALYSIS_PROVIDER=openai
RISK_ANALYSIS_TEMPERATURE=0.3
RISK_ANALYSIS_MAX_TOKENS=4096
RISK_ANALYSIS_TIMEOUT=60000
RISK_ANALYSIS_MAX_RETRIES=3

# Compliance Checker Engine
COMPLIANCE_CHECKER_PROVIDER=openai
COMPLIANCE_TEMPERATURE=0.2
COMPLIANCE_MAX_TOKENS=4096
COMPLIANCE_TIMEOUT=60000
COMPLIANCE_MAX_RETRIES=3

# Model Card Generator Engine
MODEL_CARD_PROVIDER=openai
MODEL_CARD_TEMPERATURE=0.4
MODEL_CARD_MAX_TOKENS=6000
MODEL_CARD_TIMEOUT=60000
MODEL_CARD_MAX_RETRIES=3

# Alerts Configuration
ALERTS_EVALUATION_INTERVAL=60000
ALERTS_DEFAULT_COOLDOWN=300000

# Email Provider (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
ALERTS_EMAIL_FROM=alerts@gixy.ai
ALERTS_EMAIL_TO=team@example.com
ALERTS_EMAIL_CC=
ALERTS_EMAIL_BCC=

# Webhook Provider
ALERTS_WEBHOOK_URL=https://your-webhook-endpoint.com/alerts
ALERTS_WEBHOOK_METHOD=POST
ALERTS_WEBHOOK_HEADERS='{"Content-Type": "application/json"}'
ALERTS_WEBHOOK_SECRET=your_webhook_secret
ALERTS_WEBHOOK_TIMEOUT=10000

# Slack Provider
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_ALERTS_CHANNEL=#alerts
SLACK_BOT_USERNAME=Gixy Alerts
SLACK_BOT_ICON_EMOJI=:warning:
SLACK_MENTION_USERS=U12345,U67890
SLACK_MENTION_GROUPS=G12345

# PagerDuty Provider
PAGERDUTY_ROUTING_KEY=your_routing_key
PAGERDUTY_API_URL=https://events.pagerduty.com/v2/enqueue
PAGERDUTY_SOURCE=gixy-alerts

# OpsGenie Provider
OPSGENIE_API_KEY=your_opsgenie_api_key
OPSGENIE_API_URL=https://api.opsgenie.com/v2/alerts
OPSGENIE_SOURCE=gixy-alerts
OPSGENIE_TEAMS=team1,team2
OPSGENIE_TAGS=gixy,ai-risk

# In-App Notifications
ALERTS_IN_APP_COLLECTION=notifications
ALERTS_MAX_NOTIFICATIONS_PER_USER=1000

# Alert Rules Configuration
ALERTS_RULE_HIGH_RISK=true
ALERTS_HIGH_RISK_THRESHOLD=70
ALERTS_HIGH_RISK_SEVERITY=warning
ALERTS_HIGH_RISK_COOLDOWN=3600000

ALERTS_RULE_COMPLIANCE=true
ALERTS_COMPLIANCE_FRAMEWORKS=eu_ai_act,nist_ai_rmf
ALERTS_COMPLIANCE_SEVERITY=critical
ALERTS_COMPLIANCE_COOLDOWN=3600000

ALERTS_RULE_PERFORMANCE=true
ALERTS_ACCURACY_THRESHOLD=0.85
ALERTS_PERFORMANCE_SEVERITY=warning
ALERTS_PERFORMANCE_COOLDOWN=3600000

ALERTS_RULE_DATA_DRIFT=true
ALERTS_DRIFT_THRESHOLD=0.3
ALERTS_DRIFT_SEVERITY=warning
ALERTS_DRIFT_COOLDOWN=3600000

ALERTS_RULE_SECURITY=true
ALERTS_ANOMALY_THRESHOLD=0.8
ALERTS_ANOMALY_SEVERITY=critical
ALERTS_ANOMALY_COOLDOWN=1800000

# Default Channels
ALERTS_DEFAULT_CHANNELS=in_app